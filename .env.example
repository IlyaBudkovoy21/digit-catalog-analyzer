APP_NAME=digit-catalog-analyzer
DATABASE_URL=postgresql+psycopg://catalog:catalog@db:5432/catalog
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://catalog:catalog@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# External test API base URL, for example: https://example.com
EXTERNAL_API_BASE_URL=

# Optional stable identifier sent as X-Candidate-Id.
CANDIDATE_ID=
REQUEST_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_BATCH_SIZE=3
