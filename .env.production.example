APP_NAME=digit-catalog-analyzer
DATABASE_URL=postgresql+psycopg://catalog:CHANGE_ME_DB_PASSWORD@db:5432/catalog
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://catalog:CHANGE_ME_RABBIT_PASSWORD@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

EXTERNAL_API_BASE_URL=https://example.com
CANDIDATE_ID=your-stable-candidate-id
REQUEST_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_BATCH_SIZE=3

POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
RABBITMQ_DEFAULT_USER=catalog
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBIT_PASSWORD
